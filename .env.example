# LifeOS Environment Variables
# Copy this file to .env and fill in values for local development.
# NEVER commit your .env file to version control.

# Database URL (optional — leave blank to use the default SQLite file)
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/lifeos
DATABASE_URL=

# Secret key for session signing (change this in production)
LIFEOS_SECRET_KEY=change-me-in-production-use-a-long-random-string
